# Copy this file to keystore.properties and fill in your real release key values.
# keystore.properties is ignored by Git and must never be committed.
# Forward slashes are easiest on Windows, for example F:/keys/theday-release.jks
storeFile=F:/path/to/theday-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
